---
# ==============================================================================
# MAIN INFRASTRUCTURE VARIABLES (group_vars/all/vars.yml.example)
# Copy this file to group_vars/all/vars.yml and adjust the values to your needs.
# ==============================================================================

# Main system user on target servers (owner of files and containers)
ansible_user: "sysadmin"

# Main domain used for services in the homelab environment
domain_name: "example.com"

# Email address for registering SSL/TLS certificates with Let's Encrypt
acme_email: "admin@example.com"

# IP addresses of internal network devices (for the Caddy Reverse Proxy)
qnap_ip: "10.0.0.2"

# Caddy image version (must match the base tag in roles/caddy/templates/Dockerfile.j2)
caddy_version: "2.11"
caddy_image_tag: "{{ caddy_version }}-cloudflare"

# Vaultwarden data directory (self-hosted password manager).
# If you are migrating an existing instance, place the old data/ folder under
# {{ vaultwarden_dir }}/data before or right after the first playbook run.
vaultwarden_dir: "/opt/vaultwarden"
vaultwarden_version: "1.37.1"

# Homepage configuration directory (dashboard with automatic container discovery)
homepage_dir: "/opt/homepage"
homepage_version: "v1.13.2"

# Portfolio site directory (static kaletkadev-portfolio-site checkout, served by Caddy)
portfolio_dir: "/opt/portfolio"
portfolio_repo_url: "https://github.com/KrzysztofKaletkaDev/kaletkadev-portfolio-site.git"

# Blocky DNS ad-blocker image version
blocky_version: "v0.31.0"

# Monitoring stack directory (Prometheus, node_exporter, cAdvisor, Grafana)
monitoring_dir: "/opt/monitoring"
prometheus_version: "v2.55.1"
node_exporter_version: "v1.8.2"
cadvisor_version: "v0.60.5"
grafana_version: "11.2.0"

# Cloudflare Tunnel client directory (locally-managed tunnel, zero open ports)
cloudflared_dir: "/opt/cloudflared"
cloudflared_version: "2026.8.2"

# Live camera view (roles/go2rtc + roles/camera_wall), LAN only — see ADR-0011.
# go2rtc restreams the cameras for viewing only; recording stays on the NAS.
go2rtc_dir: "/opt/go2rtc"
go2rtc_version: "1.9.14"
camera_wall_dir: "/opt/camera_wall"
# Served by Caddy at <subdomain>.<domain_name>, behind basic_auth
camera_wall_subdomain: "kamery"
camera_wall_user: "kamery"
# LAN addresses that skip the camera-wall login — the login only: the path
# allowlist and the final 403 still apply (ADR-0012). Plain IPv4 addresses,
# no ranges; meant for the wall kiosk, whose address is a DHCP reservation in
# ansible-network-template. Empty list = everyone logs in.
# NEVER a Docker address (e.g. the caddy-ingress gateway 172.x.0.1): whatever
# Docker proxies instead of routing (connections from the host itself, IPv6
# clients) reaches Caddy FROM the gateway, so listing it lets all of that skip
# the login. The caddy role refuses Docker addresses.
camera_wall_trusted_ips: []

# One list drives both go2rtc.yaml (with credentials) and the public
# cameras.json (label, stream names, mode and fit only).
#   id          - stream name: [a-z0-9_]; main stream "<id>", substream "<id>s"
#   label       - caption on the tile
#   host        - camera address; port defaults to 554 (override with "port")
#   main_path   - optional; without it there is no main stream and fullscreen
#                 shows the substream
#   sub_path    - required; shown in the grid
#   credentials - key into vault_go2rtc_credentials (omit for no auth)
#   transcode   - true re-encodes the SUBSTREAM to H.264/AAC through ffmpeg
#                 (for cameras that only send H.265); costs CPU while watched
#   mode        - mse | webrtc (a fallback list like "mse,webrtc" also works)
#   fit         - contain | fill | cover
go2rtc_cameras:
  - id: cam1
    label: "Camera 1"
    host: "10.0.0.101"
    main_path: /stream1
    sub_path: /stream2
    credentials: cam1
    mode: mse
    fit: contain
  - id: cam2
    label: "Camera 2"
    host: "10.0.0.102"
    sub_path: /12
    credentials: cam2
    transcode: true
    mode: webrtc
    fit: contain
