---
# ==============================================================================
# MAIN INFRASTRUCTURE VARIABLES (group_vars/all/vars.yml.example)
# Copy this file to group_vars/all/vars.yml and adjust the values to your needs.
# ==============================================================================

# Main system user on target servers (owner of files and containers)
ansible_user: "sysadmin"

# List of public SSH keys authorized for the admin user (roles/common).
# These are public keys, not secrets, so they live here instead of vault.yml.
common_authorized_keys: []

# Allow the wheel group to run sudo without a password prompt (roles/common)
common_sudo_nopasswd: true

# Main domain used for services in the homelab environment
domain_name: "example.com"

# Email address for registering SSL/TLS certificates with Let's Encrypt
acme_email: "admin@example.com"

# IP addresses of internal network devices (for the Caddy Reverse Proxy)
router_ip: "10.0.0.1"
qnap_ip: "10.0.0.2"

# Caddy image version (must match the base tag in roles/caddy/templates/Dockerfile.j2)
caddy_version: "2.11"
caddy_image_tag: "{{ caddy_version }}-cloudflare"

# Vaultwarden data directory (self-hosted password manager).
# If you are migrating an existing instance, place the old data/ folder under
# {{ vaultwarden_dir }}/data before or right after the first playbook run.
vaultwarden_dir: "/opt/vaultwarden"
vaultwarden_version: "1.37.1"

# Homepage configuration directory (dashboard with automatic container discovery)
homepage_dir: "/opt/homepage"
homepage_version: "v1.13.2"

# Portfolio site directory (static kaletkadev-portfolio-site checkout, served by Caddy)
portfolio_dir: "/opt/portfolio"
portfolio_repo_url: "https://github.com/KrzysztofKaletkaDev/kaletkadev-portfolio-site.git"

# Blocky DNS ad-blocker image version
blocky_version: "v0.31.0"

# Monitoring stack directory (Prometheus, node_exporter, cAdvisor, Grafana)
monitoring_dir: "/opt/monitoring"
prometheus_version: "v2.55.1"
node_exporter_version: "v1.8.2"
cadvisor_version: "v0.60.5"
grafana_version: "11.2.0"

# Cloudflare Tunnel client directory (locally-managed tunnel, zero open ports)
cloudflared_dir: "/opt/cloudflared"
cloudflared_version: "2026.8.2"
