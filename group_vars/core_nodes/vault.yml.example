---
# Ansible Vault variable template for the core_nodes group
# Copy this file to vault.yml and encrypt it with the command:
# ansible-vault encrypt group_vars/core_nodes/vault.yml

vault_cloudflare_api_token: "YOUR_CLOUDFLARE_API_TOKEN_HERE"
vault_grafana_admin_password: "CHANGE_ME_STRONG_PASSWORD"

# Cloudflare Tunnel identity (locally-managed tunnel, roles/cloudflared).
# The tunnel itself must be created manually before the first run of this role:
#   cloudflared tunnel login
#   cloudflared tunnel create <tunnel-name>
#   cloudflared tunnel route dns <tunnel-name> <domain_name>
# vault_cloudflared_tunnel_id is the UUID printed by `tunnel create`.
# vault_cloudflared_credentials_json is the full contents of the generated
# ~/.cloudflared/<tunnel-id>.json credentials file, pasted as a single value.
vault_cloudflared_tunnel_id: "YOUR_CLOUDFLARE_TUNNEL_ID_HERE"
vault_cloudflared_credentials_json: "YOUR_CLOUDFLARE_TUNNEL_CREDENTIALS_JSON_HERE"

# Camera credentials for go2rtc (roles/go2rtc), keyed by the "credentials"
# field of go2rtc_cameras. Quote every value: an unquoted all-digit password
# with a leading zero is parsed by YAML as an octal number. Special
# characters are fine — the role percent-encodes them in the RTSP URL.
# An empty user ("") is valid for cameras with a password-only account.
vault_go2rtc_credentials:
  cam1: { user: "CAMERA_USER", password: "CHANGE_ME_CAMERA_PASSWORD" }
  cam2: { user: "", password: "CHANGE_ME_CAMERA_PASSWORD" }
