services:
  cloudflared:
    image: cloudflare/cloudflared:{{ cloudflared_version | default('2026.8.2') }}
    container_name: cloudflared
    restart: unless-stopped
    command: tunnel --config /etc/cloudflared/config.yml run
    volumes:
      - {{ cloudflared_dir | default('/opt/cloudflared') }}/config.yml:/etc/cloudflared/config.yml:ro
      - {{ cloudflared_dir | default('/opt/cloudflared') }}/credentials.json:/etc/cloudflared/credentials.json:ro
    networks:
      - caddy-ingress

networks:
  caddy-ingress:
    external: true
