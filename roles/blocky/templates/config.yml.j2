# yaml-language-server: $schema=https://raw.githubusercontent.com/0xERR0R/blocky/main/docs/config.schema.json

ports:
  dns: 53
  http: 4000

# 1. MAIN UPSTREAM SERVERS — encrypted via DoH (port 443)
upstreams:
  groups:
    default:
      - https://1.1.1.1/dns-query
      - https://1.0.0.1/dns-query
      - https://9.9.9.9/dns-query
      - https://149.112.112.112/dns-query
  strategy: parallel_best
  timeout: 5s

# Servers used to resolve hostnames when downloading blocklists.
bootstrapDns:
  - tcp+udp:1.1.1.1
  - tcp+udp:9.9.9.9

# 2. DNS REWRITING / CUSTOM DNS
customDNS:
  customTTL: 1h
  mapping:
    "homepage.{{ domain_name }}": "{{ custom_dns_target_ip }}"
    "vaultwarden.{{ domain_name }}": "{{ custom_dns_target_ip }}"
    "qnap.{{ domain_name }}": "{{ custom_dns_target_ip }}"
    "router.{{ domain_name }}": "{{ custom_dns_target_ip }}"

# 3. BLOCKING ADS / TRACKERS / MALWARE
blocking:
  denylists:
    ads_and_tracking:
      - https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts
      - https://adaway.org/hosts.txt
      - https://raw.githubusercontent.com/hagezi/dns-blocklists/main/hosts/pro.txt
    poland_spec:
      - https://raw.githubusercontent.com/PolishFiltersTeam/KADhosts/master/KADhosts.txt
      - https://hole.cert.pl/domains/v2/domains_hosts.txt
    malware:
      - https://urlhaus.abuse.ch/downloads/hostfile/
      - https://raw.githubusercontent.com/hagezi/dns-blocklists/main/hosts/tif.txt

  # 4. EXCEPTIONS / WHITELIST
  allowlists:
    main_adguard_lists:
      - connectivitycheck.gstatic.com
      - connectivitycheck.android.com
      - service.minerva.devices.a2z.com

  # 5. GROUP ASSIGNMENT
  clientGroupsBlock:
    default:
      - ads_and_tracking
      - poland_spec
      - malware

  blockType: zeroIp

  loading:
    refreshPeriod: 12h
    downloads:
      timeout: 4m

# 6. CACHING
caching:
  minTime: 5m
  maxTime: 24h
  prefetching: true
