services:
  blocky:
    image: spx01/blocky:{{ blocky_version | default('v0.31.0') }}
    container_name: blocky
    restart: unless-stopped
    ports:
      - "53:53/tcp"
      - "53:53/udp"
      - "4000:4000/tcp"
    volumes:
      - ./config.yml:/app/config.yml
    environment:
      - TZ={{ timezone | default('Europe/Warsaw') }}
