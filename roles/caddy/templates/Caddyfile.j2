{
    # Global Caddy options (ACME Let's Encrypt certificate registration)
    email {{ acme_email | default('admin@' + domain_name) }}
}

# Snippet for the Cloudflare DNS-01 challenge (wildcard certs)
(cloudflare_tls) {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        propagation_delay 30s
        propagation_timeout -1
        resolvers {{ custom_dns_target_ip }}:53
    }
}

# UNIFIED BLOCK FOR THE DOMAIN AND ALL SUBDOMAINS
*.{{ domain_name }}, {{ domain_name }} {
    import cloudflare_tls

    # Static portfolio site (kaletkadev-portfolio-site), served directly by Caddy
    @root host {{ domain_name }}
    handle @root {
        root * /srv/portfolio
        file_server
    }

    # OpenWRT router
    @router host router.{{ domain_name }}
    handle @router {
        reverse_proxy https://{{ router_ip | default('10.0.0.1') }}:443 {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }

    # QNAP NAS drive
    @qnap host qnap.{{ domain_name }}
    handle @qnap {
        reverse_proxy https://{{ qnap_ip | default('10.0.0.2') }}:443 {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }

    # Homepage gateway
    @homepage host homepage.{{ domain_name }}
    handle @homepage {
        reverse_proxy homepage:3000
    }

    @vaultwarden host vaultwarden.{{ domain_name }}
    handle @vaultwarden {
        reverse_proxy /notifications/hub/negotiate vaultwarden:80
        reverse_proxy /notifications/hub vaultwarden:3012
        reverse_proxy vaultwarden:80
    }

    # Grafana monitoring dashboards
    @grafana host grafana.{{ domain_name }}
    handle @grafana {
        reverse_proxy grafana:3000
    }

    # Default response for unknown subdomains
    handle {
        respond "Homelab Infrastructure - Access Denied" 403
    }
}
