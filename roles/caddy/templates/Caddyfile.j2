{
    # Global Caddy options (ACME Let's Encrypt certificate registration)
    email {{ acme_email | default('admin@' + domain_name) }}
}

# Snippet for the Cloudflare DNS-01 challenge (wildcard certs)
(cloudflare_tls) {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        propagation_delay 30s
        propagation_timeout -1
        resolvers {{ custom_dns_target_ip }}:53
    }
}

# Security headers deliberately scoped to the static portfolio site only
# (imported inside handle @root). A strict CSP applied site-wide would break
# Grafana and Vaultwarden, which load their own inline/bundled scripts and
# styles; the static site serves fixed assets and can take the tight policy.
(portfolio_headers) {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        # no-transform forbids Cloudflare's edge from rewriting the response
        # body, which is how the Web Analytics beacon and Bot Fight Mode inject
        # inline scripts that this CSP would otherwise block. Enforcing it in
        # code, not relying on the dashboard toggles staying off.
        # Deliberate cost: Cloudflare email address obfuscation stops working
        # too, so the mailto: in index.html is visible in plain text in the
        # page source.
        Cache-Control "public, no-transform"
    }
}

# UNIFIED BLOCK FOR THE DOMAIN AND ALL SUBDOMAINS
*.{{ domain_name }}, {{ domain_name }} {
    import cloudflare_tls

    # Static portfolio site (kaletkadev-portfolio-site), served directly by Caddy
    @root host {{ domain_name }}
    handle @root {
        import portfolio_headers
        root * /srv/portfolio
        file_server
    }

    # www -> apex: single canonical hostname
    @www host www.{{ domain_name }}
    handle @www {
        redir https://{{ domain_name }}{uri} permanent
    }

    # QNAP NAS drive
    @qnap host qnap.{{ domain_name }}
    handle @qnap {
        reverse_proxy https://{{ qnap_ip | default('10.0.0.2') }}:443 {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }

    # Homepage gateway
    @homepage host homepage.{{ domain_name }}
    handle @homepage {
        reverse_proxy homepage:3000
    }

    @vaultwarden host vaultwarden.{{ domain_name }}
    handle @vaultwarden {
        reverse_proxy /notifications/hub/negotiate vaultwarden:80
        reverse_proxy /notifications/hub vaultwarden:3012
        reverse_proxy vaultwarden:80
    }

    # Grafana monitoring dashboards
    @grafana host grafana.{{ domain_name }}
    handle @grafana {
        reverse_proxy grafana:3000
    }

    # Live camera wall (LAN only: no cloudflared ingress entry, see ADR-0011).
    # An ALLOWLIST of paths, not a blocklist: /api/streams returns the RTSP
    # URLs with camera passwords and /api/config can rewrite the config
    # (including exec: sources). The player needs only /api/ws and its two
    # scripts. No portfolio_headers here (ADR-0010): the go2rtc player injects
    # inline styles that the strict CSP would block.
    @kamery host {{ camera_wall_subdomain | default('kamery') }}.{{ domain_name }}
    handle @kamery {
        basic_auth {
            {{ camera_wall_user | default('kamery') }} {{ vault_camera_wall_password_hash }}
        }
        @go2rtc path /api/ws /video-stream.js /video-rtc.js
        handle @go2rtc {
            reverse_proxy go2rtc:1984
        }
        @site path / /index.html /cameras.json
        handle @site {
            root * /srv/kamery
            file_server
        }
        handle {
            respond 403
        }
    }

    # Default response for unknown subdomains
    handle {
        respond "Homelab Infrastructure - Access Denied" 403
    }
}
