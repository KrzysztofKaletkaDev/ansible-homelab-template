services:
  caddy:
    image: "custom-caddy:{{ caddy_image_tag }}"
    container_name: caddy
    restart: unless-stopped
    ports:
      - "80:80/tcp"
      - "443:443/tcp"
      - "443:443/udp" # HTTP/3 support (QUIC)
    environment:
      - CLOUDFLARE_API_TOKEN={{ vault_cloudflare_api_token }}
    volumes:
      - {{ caddy_dir | default('/opt/caddy') }}/etc:/etc/caddy
      - {{ caddy_dir | default('/opt/caddy') }}/data:/data
      - {{ caddy_dir | default('/opt/caddy') }}/config:/config
      - {{ portfolio_dir | default('/opt/portfolio') }}/site:/srv/portfolio:ro
    networks:
      - caddy-ingress

networks:
  caddy-ingress:
    name: caddy-ingress
    driver: bridge
