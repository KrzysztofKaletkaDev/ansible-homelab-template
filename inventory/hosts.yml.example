---
# ==============================================================================
# INVENTORY TEMPLATE (inventory/hosts.yml.example)
# Copy this file, remove the .example extension (save it as hosts.yml)
# and replace the example IP addresses with real addresses in your LAN.
# ==============================================================================

all:
  children:
    core_nodes:
      hosts:
        alma-node1:
          # Main IP address of the server (e.g. a virtual machine) on which Ansible will install the services
          ansible_host: 10.0.0.10

          # IP address of the DNS service (e.g. the Blocky/AdGuard container) that traffic should point to
          custom_dns_target_ip: 10.0.0.10
